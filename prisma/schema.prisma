// Spark'26 — Prisma schema (single master database, event-wise organisation via foreign keys)
// All timestamps are UTC instants; Asia/Kolkata (IST, UTC+05:30) is used for display and input parsing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventCategory {
  TECHNICAL
  NON_TECHNICAL
}

enum RegistrationMode {
  WEBSITE
  ON_SPOT
  BOTH
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RegistrationSource {
  WEBSITE
  ON_SPOT
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
}

enum AdminRole {
  SUPERADMIN
  ADMIN
  SCANNER
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

model Student {
  id             String   @id @default(cuid())
  name           String
  registerNumber String   @unique @map("register_number")
  department     String
  academicYear   String   @map("academic_year")
  section        String
  email          String   @unique
  phone          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  registrations Registration[]

  @@index([department])
  @@index([name])
  @@map("students")
}

model Event {
  id                 String           @id @default(cuid())
  code               String           @unique // short human code used on cards + registration IDs (E01…)
  slug               String           @unique
  name               String
  category           EventCategory
  venue              String
  startsAt           DateTime         @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime         @map("ends_at") @db.Timestamptz(3)
  description        String
  registrationMode   RegistrationMode @default(BOTH) @map("registration_mode")
  imageUrl           String?          @map("image_url")
  brochureUrl        String?          @map("brochure_url")
  brochureName       String?          @map("brochure_name")
  registrationDeadline DateTime?      @map("registration_deadline") @db.Timestamptz(3)
  maxCapacity        Int?             @map("max_capacity")
  status             EventStatus      @default(DRAFT)
  createdByAdminId   String?          @map("created_by_admin_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  registrations Registration[]

  @@index([status])
  @@index([category])
  @@index([startsAt])
  @@map("events")
}

model Registration {
  id                 String             @id @default(cuid())
  registrationId     String             @unique @map("registration_id") // public, human friendly
  studentId          String             @map("student_id")
  eventId            String             @map("event_id")
  source             RegistrationSource @default(WEBSITE)
  qrToken            String             @unique @map("qr_token") // opaque, 256-bit capability secret
  status             RegistrationStatus @default(CONFIRMED)
  attendanceStatus   AttendanceStatus   @default(PENDING) @map("attendance_status")
  checkedInAt        DateTime?          @map("checked_in_at") @db.Timestamptz(3)
  checkedInByAdminId String?            @map("checked_in_by_admin_id")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at")
  createdByAdminId   String?            @map("created_by_admin_id") // set for on-spot registrations

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([studentId, eventId], name: "one_registration_per_student_per_event")
  @@index([eventId])
  @@index([studentId])
  @@index([createdAt(sort: Desc)])
  @@index([eventId, createdAt(sort: Desc)])
  @@index([eventId, status])
  @@index([studentId, status])
  @@index([attendanceStatus])
  @@index([eventId, attendanceStatus])
  @@map("registrations")
}

model AdminUser {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         AdminRole   @default(ADMIN)
  status       AdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?   @map("last_login_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?  @map("admin_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model RateLimit {
  key     String   @id @db.VarChar(255)
  count   Int      @default(1)
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("rate_limits")
}

